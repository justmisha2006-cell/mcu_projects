// --- AUDIO FUNCTIONS ---
void playAlertSound() {
  int melody[] = {880, 0, 880, 0, 1174, 0, 880, 0, 1174};
  int duration[] = {150, 50, 150, 50, 300, 50, 150, 50, 400};
  for (int i = 0; i < 9; i++) {
    if (melody[i] == 0) noTone(PIN_BUZZER);
    else tone(PIN_BUZZER, melody[i], duration[i]);
    delay(duration[i] + 30);
  }
  noTone(PIN_BUZZER);
}

void playClearSound() {
  int melody[] = {1174, 0, 880, 0, 659};
  int duration[] = {200, 50, 200, 50, 500};
  for (int i = 0; i < 5; i++) {
    if (melody[i] == 0) noTone(PIN_BUZZER);
    else tone(PIN_BUZZER, melody[i], duration[i]);
    delay(duration[i] + 30);
  }
  noTone(PIN_BUZZER);
}

