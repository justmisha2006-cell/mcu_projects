}

// KYIV LED BRIGHTNESS CONTROL
void updateKyivLed() {
  int brightness = 0;

  if (regions[0].current_alert) {
    brightness = 255; // 100% brightness on Kyiv Alert
  } else if (kyiv_region_alert) {
    brightness = 75;  // 30% brightness on Region Alert
  } else {
    brightness = 0;   // Off
  }

  #if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
    ledcWrite(PIN_LED_KYIV, brightness);
  #else
    ledcWrite(0, brightness);
  #endif
}

void setup() {
  Serial.begin(115200);

  // 1. Enable WiFi Blue LED
  pinMode(PIN_LED_WIFI, OUTPUT);
  digitalWrite(PIN_LED_WIFI, HIGH); 

  // 2. Initialize Kyiv PWM
  #if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
    ledcAttach(PIN_LED_KYIV, KYIV_PWM_FREQ, KYIV_PWM_RES);
  #else
    ledcSetup(0, KYIV_PWM_FREQ, KYIV_PWM_RES);
    ledcAttachPin(PIN_LED_KYIV, 0);
  #endif

  // 3. Setup Region Pins
  for (int i = 1; i < num_regions; i++) {
    pinMode(regions[i].pin, OUTPUT);
    digitalWrite(regions[i].pin, LOW);
  }

  // 4. Peripherals Setup
  pinMode(PIN_TOUCH_TTP223, INPUT_PULLDOWN);
  pinMode(PIN_BUZZER, OUTPUT);

  u8g2.begin();

  draw_splash_screen();
  delay(2000);

  // 5. WiFi & NTP Connect
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(250);
  }

  configTzTime(time_zone, ntpServer);
}

void checkAlerts() {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;
  if (http.begin(client, api_url)) {
    int httpCode = http.GET();
    if (httpCode == HTTP_CODE_OK) {
      String payload = http.getString();
      
      DynamicJsonDocument doc(12288); 
      DeserializationError error = deserializeJson(doc, payload);

      if (!error) {
        JsonObject states = doc["states"];

        kyiv_region_alert = states["Київська область"]["alertnow"] | false;
        bool current_sound_region_alert = false;

        for (int i = 0; i < num_regions; i++) {
          bool newAlertState = states[regions[i].json_name]["alertnow"] | false;

          // Check if state changed -> add notification to queue
          if (!first_check && newAlertState != regions[i].current_alert) {
            pushNotification(regions[i].name_en, newAlertState);
          }

          regions[i].current_alert = newAlertState;

          if (strcmp(regions[i].json_name, "м. Київ") != 0) {
            digitalWrite(regions[i].pin, newAlertState ? HIGH : LOW);
          }

          if (strcmp(regions[i].json_name, SOUND_REGION) == 0) {
            current_sound_region_alert = regions[i].current_alert;
          }
        }

        // Buzzer Logic on tracked region status change
        if (!first_check) {
          if (current_sound_region_alert != sound_region_alert_state) {
            if (current_sound_region_alert) {
              playAlertSound();
            } else {
              playClearSound();
            }
          }
        }
        sound_region_alert_state = current_sound_region_alert;

        updateKyivLed();
        first_check = false;
      }
    }
    http.end();
  }
}

static Notification currentActiveNotif;

void loop() {
  // API Fetch Every 15s
  if (millis() - last_update >= update_interval || last_update == 0) {
    last_update = millis();
    checkAlerts();
  }

  // Automatic screen switch every 5 seconds (when no notification active)
  if (millis() - last_screen_toggle >= SCREEN_TOGGLE_INTERVAL) {
    last_screen_toggle = millis();
    current_auto_screen = (current_auto_screen + 1) % 2;
  }

  // Check Pop-Up Notification Queue
  if (!isShowingNotification && queueCount > 0) {
    if (popNotification(currentActiveNotif)) {
      isShowingNotification = true;
      notifStartTime = millis();
    }
  }

  if (isShowingNotification) {
    if (millis() - notifStartTime >= NOTIF_DISPLAY_TIME) {
      isShowingNotification = false; // 5 seconds expired
    }
  }

  // Read Touch Sensor
  int button_state = digitalRead(PIN_TOUCH_TTP223);

  u8g2.clearBuffer();
  
  if (button_state == HIGH) {
    // Touch button overrides all screens
    drawAlertIcons();
  } else if (isShowingNotification) {
    // Priority Pop-up for Alert / Clear Event (5s)
    drawNotificationScreen(currentActiveNotif.regionNameEn, currentActiveNotif.isAlert);
  } else {
    // Default screens toggle
    if (current_auto_screen == 0) {
      drawMainClockScreen();
    } else {
      drawSystemDashboardScreen();
    }
  }

  u8g2.sendBuffer();
  delay(20);
}