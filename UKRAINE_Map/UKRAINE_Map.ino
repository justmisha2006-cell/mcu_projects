// --- NOTIFICATION QUEUE STRUCTURE ---
struct Notification {
  const char* regionNameEn;
  bool isAlert; // true = ALERT STARTED, false = CLEAR
};

#define MAX_QUEUE_SIZE 16
Notification notifQueue[MAX_QUEUE_SIZE];
int queueHead = 0;
int queueTail = 0;
int queueCount = 0;

unsigned long notifStartTime = 0;
bool isShowingNotification = false;
const unsigned long NOTIF_DISPLAY_TIME = 5000; // Display notification for 5 seconds

void pushNotification(const char* nameEn, bool isAlert) {
  if (queueCount < MAX_QUEUE_SIZE) {
    notifQueue[queueTail].regionNameEn = nameEn;
    notifQueue[queueTail].isAlert = isAlert;
    queueTail = (queueTail + 1) % MAX_QUEUE_SIZE;
    queueCount++;
  }
}

bool popNotification(Notification &notif) {
  if (queueCount == 0) return false;
  notif = notifQueue[queueHead];
  queueHead = (queueHead + 1) % MAX_QUEUE_SIZE;
  queueCount--;
  return true;
}

