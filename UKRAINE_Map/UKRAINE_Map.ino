// SCREEN 1: Main Clock Screen
void drawMainClockScreen(void) {
  struct tm timeinfo;
  
  if (!getLocalTime(&timeinfo)) {
    u8g2.setFont(u8g2_font_7x14_tr);
    u8g2.drawStr(5, 20, "Syncing Time...");
  } else {
    u8g2.setFont(u8g2_font_7x14_tr);
    char dateStr[32];
    strftime(dateStr, sizeof(dateStr), "%Y-%m-%d %a", &timeinfo);
    u8g2.drawStr(5, 15, dateStr);

    char timeStr[16];
    strftime(timeStr, sizeof(timeStr), "%H:%M:%S", &timeinfo);
    u8g2.setFont(u8g2_font_9x15_tr);
    u8g2.drawStr(28, 38, timeStr);
  }
  
  u8g2.setFont(u8g2_font_ncenB08_tr);
  u8g2.drawStr(18, 58, "AIR ALERT MAP");
}

// SCREEN 2: Brand New System & Monitor Dashboard
void drawSystemDashboardScreen(void) {
  int activeAlertsCount = 0;
  for (int i = 0; i < num_regions; i++) {
    if (regions[i].current_alert) activeAlertsCount++;
  }

  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.drawStr(0, 10, "--- SYSTEM STATUS ---");

  // Wi-Fi Status
  u8g2.setFont(u8g2_font_5x7_tr);
  if (WiFi.status() == WL_CONNECTED) {
    u8g2.drawStr(0, 22, "WiFi: CONNECTED");
    char rssiStr[20];
    snprintf(rssiStr, sizeof(rssiStr), "Signal: %d dBm", WiFi.RSSI());
    u8g2.drawStr(0, 31, rssiStr);
  } else {
    u8g2.drawStr(0, 22, "WiFi: DISCONNECTED");
  }

  // Active Alerts Summary
  char alertSummary[30];
  snprintf(alertSummary, sizeof(alertSummary), "Active Alerts: %d / %d", activeAlertsCount, num_regions);
  u8g2.drawStr(0, 43, alertSummary);

  // Sound region state
  if (sound_region_alert_state) {
    u8g2.drawStr(0, 54, "Kyiv Sound: [ALERT!]");
  } else {
    u8g2.drawStr(0, 54, "Kyiv Sound: [SAFE]");
  }

  u8g2.drawHLine(0, 62, 128);
}

// POPUP NOTIFICATION SCREEN (Shows 5 seconds per event)
void drawNotificationScreen(const char* regionNameEn, bool isAlert) {
  u8g2.drawFrame(0, 0, 128, 64);
  u8g2.drawFrame(2, 2, 124, 60);

  u8g2.setFont(u8g2_font_7x14_tr);
  if (isAlert) {
    u8g2.drawStr(12, 18, "! AIR ALERT !");
  } else {
    u8g2.drawStr(18, 18, "ALL CLEAR");
  }

  u8g2.drawHLine(10, 23, 108);

  u8g2.setFont(u8g2_font_6x10_tr);
  int textWidth = u8g2.getStrWidth(regionNameEn);
  int startX = (128 - textWidth) / 2;
  if (startX < 4) startX = 4;
  u8g2.drawStr(startX, 38, regionNameEn);

  u8g2.setFont(u8g2_font_5x7_tr);
  if (isAlert) {
    u8g2.drawStr(18, 52, "TAKE SHELTER NOW!");
  } else {
    u8g2.drawStr(20, 52, "DANGER HAS PASSED");
  }
}

